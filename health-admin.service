# Health Admin Panel - системный systemd-юнит, работает от root (User= не задан).
# Тот же стиль, что и health-agent.service - см. этот файл для деталей
# (EnvironmentFile, алерт о сбое через OnFailure= и ExecStopPost=).
#
# Установка (от root, подробности в DEPLOY.md):
#   cp health-admin.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now health-admin.service
#
# Пароль администратора (один раз, до первого запуска):
#   python -m admin.server --set-password
#   # две выведенные строки вручную добавить в /root/.hermes/.env:
#   #   ADMIN_PASSWORD_HASH=...
#   #   ADMIN_PASSWORD_SALT=...
#
# Панель слушает ТОЛЬКО 127.0.0.1:8765 — снаружи VPS недоступна. Доступ с
# рабочей машины — ssh-туннель:
#   ssh -L 8765:localhost:8765 user@vps
# затем открыть в браузере http://localhost:8765/
#
# Публичный (не loopback) --host требует TLS-реверс-прокси перед собой
# (см. admin/README-proxy.md) и ADMIN_BEHIND_TLS=1 — без этого сервис
# отказывается стартовать (см. admin/server.py::_refuse_exposed_bind).
#
# Статус и логи:
#   systemctl status health-admin.service
#   journalctl -u health-admin.service -f

[Unit]
Description=Health Admin Panel (stdlib HTTP server, 127.0.0.1 only)
After=network.target
OnFailure=health-alert@%n.service

[Service]
Type=simple
Restart=on-failure
RestartSec=10

# User= не указывается: юнит системный, исполняется от root.

EnvironmentFile=%h/.hermes/.env
ExecStopPost=-/bin/sh -c '[ "$$SERVICE_RESULT" = success ] || systemctl start --no-block health-alert@%n.service'

# ЗАМЕНИТЬ на реальный путь клона репозитория на VPS (тот же PROJECT_DIR,
# что передавался в install.sh) — admin/ и plugin/ не копируются в ~/.hermes,
# они запускаются прямо из чекаута.
WorkingDirectory=/opt/webapps/health_agent_system
ExecStart=/opt/webapps/health_agent_system/.venv/bin/python -m admin.server --host 127.0.0.1 --port 8765

# Слабый VPS. Значение ставить ПОСЛЕ замера реального RSS (как в
# health-agent.service), не наугад.
# MemoryMax=150M

StandardOutput=journal
StandardError=journal
SyslogIdentifier=health-admin

[Install]
WantedBy=default.target
