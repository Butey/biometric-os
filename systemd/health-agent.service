# Health Agent Bot - системный systemd-юнит, работает от root (User= не задан).
#
# Установка (от root, подробности в DEPLOY.md):
#   cp systemd/health-agent.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now health-agent.service
#
# EnvironmentFile указывает на .env проекта; замените путь при другой установке.
#
# Сбой уходит админам в телеграм через health-alert@.service (systemd/).
# ExecStopPost= нужен именно здесь: при Restart=on-failure и RestartSec=10
# лимит запусков по умолчанию (5 за 10 с) не достигается никогда, юнит не
# попадает в failed, и OnFailure= молчит при любом количестве падений.
# SERVICE_RESULT=success при штатном stop/restart - деплой алерт не шлёт.
#
# Статус и логи:
#   systemctl status health-agent.service
#   journalctl -u health-agent.service -f

[Unit]
Description=Health Agent Bot
After=network-online.target
Wants=network-online.target
OnFailure=health-alert@%n.service

[Service]
Type=simple
Restart=on-failure
RestartSec=10

# User= не указывается: юнит системный, исполняется от root.

EnvironmentFile=/opt/webapps/health_agent_system/.env
Environment=PYTHONUNBUFFERED=1
# Панель поднимает только health-admin.service: иначе бот, стартовав раньше,
# занимает 8765 сам, и health-admin падает в цикле с EADDRINUSE.
Environment=HEALTH_ADMIN_AUTOSTART=0
ExecStopPost=-/bin/sh -c '[ "$$SERVICE_RESULT" = success ] || systemctl start --no-block health-alert@%n.service'

# Бот работает из каталога проекта: персона,
# config.yaml, Knowledge/ и код читаются отсюда, и правка файла сразу боевая.
# Путь подставить свой, если проект развёрнут не в ~/Health_agent_system.
WorkingDirectory=/opt/webapps/health_agent_system
ExecStart=/opt/webapps/health_agent_system/.venv/bin/python -m bot.main

# Слабый VPS. Значение ставить ПОСЛЕ замера реального RSS (шаг замера в DEPLOY.md),
# а не наугад: заниженный MemoryMax убьёт бота посреди диалога.
# MemoryMax=450M

StandardOutput=journal
StandardError=journal
SyslogIdentifier=health-agent

[Install]
WantedBy=default.target
