# Один прогон cron-скрипта через notify.py; %i — имя скрипта в scripts/ без .py.
# Пояс человека для «сегодня» выставляет сам notify.py (TZ дочернего процесса),
# а время срабатывания — OnCalendar в таймерах этого каталога.
# ponytail: таймеры несут один пояс (профиль единственного пользователя). Люди в
# разных поясах — нужен диспетчер, который раз в 15 мин смотрит users.timezone.
#
# Установка: systemctl link /opt/webapps/health_agent_system/systemd/*.service
#            systemctl enable --now /opt/webapps/health_agent_system/systemd/*.timer
[Unit]
Description=Health notify: %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/webapps/health_agent_system
ExecStart=/opt/webapps/health_agent_system/.venv/bin/python scripts/notify.py scripts/%i.py --all
