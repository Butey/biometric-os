# Установка: systemctl link (юнит живёт в каталоге проекта), см. DEPLOY.md.
[Unit]
Description=Health notify: export_backup (админам)
OnFailure=health-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/webapps/health_agent_system
ExecStart=/opt/webapps/health_agent_system/.venv/bin/python scripts/notify.py scripts/export_backup.py --admins
